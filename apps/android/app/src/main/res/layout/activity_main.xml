<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Conteúdo Principal da Aplicação -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Cabeçalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@color/bg_surface">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cliente Android Nativo"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Desconectado"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- Configuração do Servidor Local -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:strokeColor="@color/border_subtle"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/server_url_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/edtServerUrl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="http://192.168.1.4:3001"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:inputType="textUri"
                            android:padding="10dp" />

                        <Button
                            android:id="@+id/btnConnectServer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Conectar"
                            android:textSize="12sp"
                            app:backgroundTint="@color/accent_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Container: Estado NÃO PAREADO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUnpaired"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:strokeColor="@color/border_subtle"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Parear Aparelho"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Digite o código de 6 dígitos gerado no card do Dashboard:"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtPairingCode"
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:hint="000000"
                        android:inputType="number"
                        android:maxLength="6"
                        android:fontFamily="monospace"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.3"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:padding="12dp" />

                    <TextView
                        android:id="@+id/txtPairingError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/accent_rose"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Código inválido ou expirado" />

                    <Button
                        android:id="@+id/btnSubmitPairing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:padding="12dp"
                        android:text="@string/connect_button"
                        app:backgroundTint="@color/accent_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Container: Estado PAREADO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaired"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bg_surface"
                app:strokeColor="@color/accent_emerald"
                app:cardCornerRadius="16dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/paired_status"
                        android:textColor="@color/accent_emerald"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCardName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Celular Estoque 01"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDeviceId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:text="ID: abcd1234..."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@color/bg_primary"
                        android:padding="12dp"
                        android:gravity="center"
                        android:text="@string/waiting_commands"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="☀️ Tela mantida ligada (FLAG_KEEP_SCREEN_ON)"
                        android:textColor="@color/accent_emerald"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnUnpair"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/unpair_button"
                        app:backgroundTint="@color/accent_rose" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Segundo Plano e Modos de Alerta -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:strokeColor="@color/border_subtle"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alert_options_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchForegroundService"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/background_service_toggle"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:checked="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mantém o socket e Wi-Fi ativos em 2º plano e acende a tela mesmo bloqueada."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/border_subtle" />

                    <CheckBox
                        android:id="@+id/chkScreenRed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/opt_screen_red"
                        android:textColor="@color/text_secondary"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/chkSoundAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/opt_sound"
                        android:textColor="@color/text_secondary"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/chkVibrationAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/opt_vibrate"
                        android:textColor="@color/text_secondary"
                        android:checked="true" />

                    <Button
                        android:id="@+id/btnBatteryOptimization"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/battery_optimization_btn"
                        android:textSize="12sp"
                        app:strokeColor="@color/border_subtle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Overlay de Tela 100% Vermelha (#FF0000) por 5 Segundos (Sem textos, sem botões) -->
    <View
        android:id="@+id/fullScreenRedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/alert_red"
        android:visibility="gone"
        tools:visibility="gone" />

</FrameLayout>
