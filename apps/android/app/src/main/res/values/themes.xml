<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PhoneFinder" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
    </style>

    <style name="Theme.PhoneFinder.Alert" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/alert_red</item>
        <item name="android:statusBarColor">@color/alert_red</item>
        <item name="android:navigationBarColor">@color/alert_red</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
